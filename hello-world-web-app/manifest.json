{
  "manifestVersion": 1,
  "meta": {
    "name": "Hello World Web App",
    "version": "0.0.1",
    "logoPath": "logo.png",
    "shortDescription": "A simple web app that displays a greeting.",
    "longDescription": "This PUP runs a lightweight web server that serves a static page with a customizable greeting message. It is intended as a minimal example for DogeBox OS.",
    "upstreamVersions": {
      "App": "0.1.0"
    }
  },
  "config": {
    "sections": [
      {
        "name": "Main Settings",
        "description": "Generated by PupWizard.",
        "fields": [
          {
            "name": "MESSAGE",
            "label": "Greeting Message",
            "type": "text",
            "default": "Hello World"
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "0966bc3367ab2f41d222c049c60dcf5de085b389e2261f0781344edf98ab48d7"
    },
    "services": [
      {
        "name": "hello-world-web-app",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "http",
        "type": "http",
        "port": 8080,
        "interfaces": [
          "hello-world-web-app-http"
        ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": false
  },
  "interfaces": [
    {
      "name": "hello-world-web-app-http",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "HTTP",
          "description": "HTTP access for this pup",
          "severity": 2,
          "routes": [
            "/*"
          ],
          "port": 0
        }
      ]
    }
  ],
  "dependencies": [],
  "metrics": [
    {
      "name": "uptime_seconds",
      "label": "Uptime",
      "type": "int",
      "history": 30
    }
  ]
}
