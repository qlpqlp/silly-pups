{
  "manifestVersion": 1,
  "meta": {
    "name": "Hello World Pup",
    "version": "0.0.1",
    "logoPath": "logo.png",
    "shortDescription": "A simple Hello World web app",
    "longDescription": "This pup runs a minimal web server that serves a static Hello World page. It demonstrates how to create a basic web app on DogeBox OS.",
    "upstreamVersions": {
      "App": "0.1.0"
    }
  },
  "config": {
    "sections": [
      {
        "name": "Main Settings",
        "description": "Generated by PupWizard.",
        "fields": [
          {
            "name": "GREETING",
            "label": "Greeting Text",
            "type": "text",
            "default": "Hello, World!"
          },
          {
            "name": "ENABLE_LOGGING",
            "label": "Enable Logging",
            "type": "toggle",
            "default": false
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "c45faeb5f13d5585c6eddae52a469d315f6048a0f661b04853795772ce6f89eb"
    },
    "services": [
      {
        "name": "hello-world",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "http",
        "type": "http",
        "port": 8080,
        "interfaces": [
          "hello-world-http"
        ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": false
  },
  "interfaces": [
    {
      "name": "hello-world-http",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "HTTP",
          "description": "HTTP access for this pup",
          "severity": 2,
          "routes": [
            "/*"
          ],
          "port": 0
        }
      ]
    }
  ],
  "dependencies": [],
  "metrics": [
    {
      "name": "uptime_seconds",
      "label": "Uptime",
      "type": "int",
      "history": 30
    }
  ]
}
