{
  "manifestVersion": 1,
  "meta": {
    "name": "HelloWorld",
    "version": "0.0.1",
    "logoPath": "logo.png",
    "shortDescription": "Simple hello world web app",
    "longDescription": "A minimal web application that displays a customizable greeting on the homepage.",
    "upstreamVersions": {
      "App": "1.0"
    }
  },
  "config": {
    "sections": [
      {
        "name": "Main Settings",
        "description": "Generated by PupWizard.",
        "fields": [
          {
            "name": "GREETING",
            "label": "Greeting message",
            "type": "text",
            "default": "Hello, World!"
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "04fbc16d60076e26ea2b9739b7004d17bfc835beb558159246528b7db8939b2a"
    },
    "services": [
      {
        "name": "hello-world",
        "command": {
          "exec": "python -m http.server 8080",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "http",
        "type": "http",
        "port": 8080,
        "interfaces": [
          "hello-world-http"
        ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": false
  },
  "interfaces": [
    {
      "name": "hello-world-http",
      "version": "0.0.1",
      "permissionGroups": [
        {
          "name": "HTTP",
          "description": "HTTP access for this pup",
          "severity": 2,
          "routes": [
            "/*"
          ],
          "port": 0
        }
      ]
    }
  ],
  "dependencies": [],
  "metrics": [
    {
      "name": "uptime_seconds",
      "label": "Uptime",
      "type": "int",
      "history": 30
    }
  ]
}
