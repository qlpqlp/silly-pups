{
  "manifestVersion": 1,
  "meta": {
    "name": "MemeTracker",
    "version": "0.0.3",
    "logoPath": "logo.png",
    "shortDescription": "Track Dogecoin payments to an address (mempool)",
    "longDescription": "MemeTracker is a Go-based Dogecoin mempool tracker. Open the web UI at http://[DogeBOX-IP]:33555 (default HTTP port) for usage and example URLs, or call GET /track/<P2PKH address> on that port to start monitoring a payout address. Responses include recent matching transactions (limited by config). Addresses are retained for a configurable number of days after the last /track request, then removed with their stored transactions.",
    "upstreamVersions": {
      "Go": "1.24"
    }
  },
  "config": {
    "sections": [
      {
        "name": "Web API",
        "description": "HTTP API for starting/stopping tracking and reading transactions",
        "fields": [
          {
            "name": "PUBLIC_PORT",
            "label": "HTTP Port",
            "type": "text",
            "default": "33555"
          },
          {
            "name": "NETWORK",
            "label": "Dogecoin Network",
            "type": "text",
            "default": "mainnet"
          },
          {
            "name": "LIST_LIMIT",
            "label": "Max recent transactions to return per address",
            "type": "text",
            "default": "10"
          }
        ]
      },
      {
        "name": "Tracking Retention",
        "description": "How long to keep an address and its transactions after last request",
        "fields": [
          {
            "name": "RETENTION_DAYS",
            "label": "Retention days without /track requests",
            "type": "text",
            "default": "7"
          }
        ]
      },
      {
        "name": "P2P Mempool Listener",
        "description": "Peer connections for mempool monitoring",
        "fields": [
          {
            "name": "P2P_HOST",
            "label": "Optional P2P peer host override (empty = DNS seeds)",
            "type": "text",
            "default": ""
          },
          {
            "name": "P2P_PORT",
            "label": "Optional P2P peer port override",
            "type": "text",
            "default": "22556"
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "c17594da0af70b515c8ee7081ae163ad1c7dea5b54d6f7b801a6d78d9d4f8917"
    },
    "services": [
      {
        "name": "memetracker",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "public-port",
        "type": "http",
        "port": 33555,
        "interfaces": [
          "memetracker-public"
        ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": [
    {
      "name": "memetracker-public",
      "version": "0.0.3",
      "permissionGroups": [
        {
          "name": "MemeTracker HTTP",
          "description": "Web UI, health check, and track API for P2PKH Dogecoin addresses",
          "severity": 1,
          "routes": [
            "/",
            "/healthz",
            "/track/*"
          ],
          "port": 33555
        }
      ]
    }
  ],
  "dependencies": [],
  "metrics": [
    {
      "name": "tracked_transactions",
      "label": "Tracked transactions stored",
      "type": "int",
      "history": 30
    },
    {
      "name": "watched_addresses",
      "label": "Watched addresses",
      "type": "int",
      "history": 30
    },
    {
      "name": "mempool_tx_count",
      "label": "Mempool tx observed (unique)",
      "type": "int",
      "history": 30
    },
    {
      "name": "p2p_connected",
      "label": "P2P connected",
      "type": "string",
      "history": 1
    },
    {
      "name": "p2p_peer_detail",
      "label": "P2P peer details",
      "type": "string",
      "history": 1
    },
    {
      "name": "latest_tracked_payment",
      "label": "Latest tracked payment",
      "type": "string",
      "history": 1
    }
  ]
}

