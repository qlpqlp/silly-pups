{
  "manifestVersion": 1,
  "meta": {
    "name": "PQ Doge Wallet",
    "version": "0.0.3",
    "logoPath": "logo.png",
    "shortDescription": "The first Post Quantum Secure Dogecoin wallet",
    "longDescription": "Built in with libdogecoin liboqs that includes: `such` (P2PKH keys, Falcon-512 keygen, sign, commitments), `sendtx` (P2P broadcast), `spvnode` (headers + BIP37 + SMPV).",
    "upstreamVersions": {
      "Go": "1.24",
      "libdogecoin": "a120e03 + liboqs"
    }
  },
  "config": {
    "sections": [
      {
        "name": "HTTP",
        "description": "Web UI and JSON API bind address is 0.0.0.0 inside the container.",
        "fields": [
          {
            "name": "PUBLIC_PORT",
            "label": "HTTP port",
            "type": "text",
            "default": "33880"
          }
        ]
      },
      {
        "name": "Chain & SPV",
        "description": "libdogecoin spvnode syncs headers and watches your address; SMPV augments mempool visibility.",
        "fields": [
          {
            "name": "SPVNODE_ENABLE",
            "label": "Start spvnode after wallet is created (1=yes, 0=no)",
            "type": "text",
            "default": "1"
          }
        ]
      },
      {
        "name": "Dogecoin Core RPC (optional)",
        "description": "If the CORE pup or another node exposes JSON-RPC, set URL and credentials for send and confirmations.",
        "fields": [
          {
            "name": "DOGE_RPC_URL",
            "label": "RPC URL (e.g. http://127.0.0.1:22555)",
            "type": "text",
            "default": ""
          },
          {
            "name": "DOGE_RPC_USER",
            "label": "RPC user",
            "type": "text",
            "default": ""
          },
          {
            "name": "DOGE_RPC_PASS",
            "label": "RPC password",
            "type": "text",
            "default": ""
          }
        ]
      },
      {
        "name": "Integration",
        "description": "Optional MemeTracker and block explorer helpers.",
        "fields": [
          {
            "name": "MEMETRACKER_BASE_URL",
            "label": "MemeTracker base URL (empty = disabled)",
            "type": "text",
            "default": ""
          },
          {
            "name": "EXPLORER_TX_API",
            "label": "Explorer tx API URL with {txid} placeholder (empty = disabled)",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "7108b11eea2fb8e6fa3449361b3cd4c4ab90b3471c749ab159da9a2f393339db"
    },
    "services": [
      {
        "name": "pq-wallet",
        "command": {
          "exec": "/bin/run.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "http",
        "type": "http",
        "port": 33880,
        "interfaces": [
          "pq-wallet-http"
        ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": [
    {
      "name": "pq-wallet-http",
      "version": "0.0.3",
      "permissionGroups": [
        {
          "name": "PQ Wallet HTTP",
          "description": "Web UI and wallet API",
          "severity": 2,
          "routes": [
            "/",
            "/logo.png",
            "/static/*",
            "/api/*"
          ],
          "port": 33880
        }
      ]
    }
  ],
  "dependencies": [],
  "metrics": [
    {
      "name": "uptime_seconds",
      "label": "Uptime",
      "type": "int",
      "history": 30
    }
  ]
}
