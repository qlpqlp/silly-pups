{
  "manifestVersion": 1,
  "meta": {
    "name": "Quantum Explorer",
    "version": "0.1.24",
    "logoPath": "logo.png",
    "shortDescription": "Dogecoin blockchain explorer with Core RPC indexer and PQ transaction metrics",
    "longDescription": "Quantum Explorer indexes Dogecoin blockchain data from Dogecoin Core RPC into local PostgreSQL tables and provides a public web explorer. Users can search by address, transaction id, block height, and block hash, then open detailed block and transaction views with decoded inputs, outputs, and OP_RETURN data. Quantum transactions are classified from decoded raw transaction bytes using OP_RETURN marker checks, with metrics and recent activity available in the interface.",
    "upstreamVersions": {
      "Go": "1.24",
      "PostgreSQL": "16"
    }
  },
  "config": {
    "sections": [
      {
        "name": "Web",
        "description": "HTTP port is inside the container; open the URL Dogebox shows for this pup.",
        "fields": [
          { "name": "PUBLIC_PORT", "label": "HTTP port", "type": "text", "default": "33666" },
          { "name": "NETWORK", "label": "Network (mainnet/testnet)", "type": "text", "default": "mainnet" }
        ]
      },
      {
        "name": "Dogecoin Core RPC",
        "description": "Required for full-chain indexing. Read-only RPC. Point QE_CORE_RPC_URL at your Core node (dependency interface core-rpc when linked).",
        "fields": [
          { "name": "QE_CORE_RPC_URL", "label": "RPC base URL (http://host:port)", "type": "text", "default": "" },
          { "name": "QE_CORE_RPC_USER", "label": "RPC username", "type": "text", "default": "" },
          { "name": "QE_CORE_RPC_PASSWORD", "label": "RPC password", "type": "password", "default": "" },
          { "name": "QE_CORE_RPC_TIMEOUT_MS", "label": "RPC timeout ms", "type": "text", "default": "8000" },
          { "name": "QE_CORE_INDEXER_AUTO_START", "label": "Start indexer with app (1=yes)", "type": "text", "default": "1" },
          { "name": "QE_CORE_BACKFILL_BATCH", "label": "Blocks per indexer batch", "type": "text", "default": "20" },
          { "name": "QE_CORE_RAW_BACKFILL_BATCH", "label": "Txs per idle pass to store raw hex in Postgres (getrawtransaction)", "type": "text", "default": "40" },
          { "name": "QE_CORE_START_HEIGHT", "label": "Start height on fresh DB", "type": "text", "default": "6147099" }
        ]
      },
      {
        "name": "Access and Security",
        "description": "Admin routes use token in URL. Public APIs can be token-gated by path.",
        "fields": [
          { "name": "QE_ADMIN_TOKEN", "label": "Admin token for /admin/<TOKEN>", "type": "password", "default": "QUANTUM-TOKEN" },
          { "name": "QE_ADMIN_ALLOWLIST", "label": "Optional: comma-separated admin IPs", "type": "text", "default": "" },
          { "name": "QE_PUBLIC_API_TOKEN", "label": "Optional: token for protected public APIs", "type": "password", "default": "" },
          { "name": "QE_PUBLIC_API_ALLOWLIST", "label": "Optional: IPs for protected public APIs", "type": "text", "default": "" },
          { "name": "QE_PUBLIC_PROTECTED_PATHS", "label": "Protected paths (comma-separated)", "type": "text", "default": "" },
          { "name": "QE_PUBLIC_RATE_LIMIT", "label": "Public API requests per IP per window", "type": "text", "default": "120" },
          { "name": "QE_PUBLIC_RATE_WINDOW_SEC", "label": "Rate-limit window seconds", "type": "text", "default": "60" }
        ]
      }
    ]
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "79faac9314446a0b749afed38ba13153c0fcddd001daa492855b9fcbc8e9b7d8"
    },
    "services": [
      {
        "name": "quantum-explorer",
        "command": { "exec": "/bin/run.sh", "cwd": "", "env": null }
      }
    ],
    "exposes": [
      {
        "name": "public-port",
        "type": "http",
        "port": 33666,
        "interfaces": [ "quantum-explorer-public" ],
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": [
    {
      "name": "quantum-explorer-public",
      "version": "0.1.24",
      "permissionGroups": [
        {
          "name": "Quantum Explorer HTTP",
          "description": "Public explorer UI and APIs",
          "severity": 2,
          "routes": [ "/", "/logo.png", "/api/public/*", "/admin/*", "/api/admin/*" ],
          "port": 33666
        }
      ]
    }
  ],
  "dependencies": [
    {
      "interfaceName": "core-rpc",
      "interfaceVersion": "0.0.2",
      "permissionGroups": [ "RPC" ],
      "optional": true,
      "source": {
        "sourceLocation": "",
        "pupName": "",
        "pupVersion": "",
        "pupLogoBase64": ""
      }
    }
  ],
  "metrics": [
    { "name": "pq_seen", "label": "PQ seen", "type": "int", "history": 30 },
    { "name": "pq_confirmed", "label": "PQ confirmed", "type": "int", "history": 30 },
    { "name": "pq_invalid", "label": "PQ invalid", "type": "int", "history": 30 }
  ]
}
